model Product {
  id            Int      @id @default(autoincrement())
  name          String
  slug          String   @unique
  description   String
  stockQuantity Int
  price         Decimal  @db.Decimal(12, 2)
  categoryId    Int
  category      Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([categoryId])
}
