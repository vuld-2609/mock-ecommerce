<!doctype html>
<html lang="{{lang}}">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{{heading}}</title>
    {{> styles}}
  </head>
  <body>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" class="wrapper">
      <tr>
        <td align="center">
          <table role="presentation" width="480" cellpadding="0" cellspacing="0" class="card">
            {{> header}}
            <tr>
              <td class="content">
                <h1 class="heading">{{heading}}</h1>
                <p class="greeting">{{greeting}}</p>
                <p class="body-text">{{body}}</p>
                <table role="presentation" cellpadding="0" cellspacing="0" style="margin: 0 auto;">
                  <tr>
                    <td class="button-wrap">
                      <a href="{{url}}" class="button">{{button}}</a>
                    </td>
                  </tr>
                </table>
                <p class="expiry">{{expiry}}</p>
                <p class="raw-link">{{url}}</p>
              </td>
            </tr>
            {{> footer}}
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
